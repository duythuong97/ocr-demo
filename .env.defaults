# Default tuning parameters — committed to git.
# Works for both local dev and Docker out of the box.
# Override secrets/host-specific values in .env (not committed).

# ── Solr ──────────────────────────────────────────────────────────────────────
SOLR_URL=http://localhost:8983/solr/documents
SOLR_TIMEOUT=10

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semantic_chunks
SEMANTIC_MIN_SCORE=0.45
SEMANTIC_MAX_TEXT_CHARS=250000
SEMANTIC_MAX_CHUNKS_PER_FILE=120
EMBED_BATCH_SIZE=5
EMBED_TIMEOUT=180
SEMANTIC_SKIP_FILE_TYPES=css,scss,less,html,json,yaml,yml,txt,lock,svg,png,jpg,jpeg,gif,ico,woff,woff2,ttf,eot,map

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDER_URL=http://localhost:11434/v1
SEMANTIC_MODEL=bge-m3:latest

# ── Neo4j / Graph (set GRAPH_ENABLED=true in .env to activate) ────────────────
GRAPH_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
GRAPH_RULES_PATH=graph_rules.yaml
AGENT_MAX_ITERATIONS=8

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=500
RAG_TOP_K=5
RAG_CONTEXT_CHARS_PER_DOC=4000
RAG_SYSTEM_PROMPT=You are a helpful assistant. Answer ONLY based on the context documents provided below. Do NOT use your own training knowledge or make up information that is not present in the context. Cite the source file name when referencing specific content. If the context documents do not contain the answer, respond with a message in the same language as the user's question saying you could not find relevant information in the indexed documents.

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_URL=http://localhost:11434/v1
RERANKER_MODEL=qwen2.5:3b
RERANKER_LISTWISE_BATCH=20

# ── Search / Retrieval ────────────────────────────────────────────────────────
DEFAULT_ROWS=10
DEFAULT_OPERATOR=OR
DEFAULT_PARSER=edismax
RETRIEVAL_RRF_K=60

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5100
SHUTDOWN_FORCE_EXIT_SECONDS=8
APP_PREFIX=ocr-search
SIMULATE_SUBDIRECTORY=true

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=postgresql://ocr:ocr@localhost:5432/ocr

# ── OCR ───────────────────────────────────────────────────────────────────────
# PaddleOCR language: en, japan, ch, latin (Vietnamese/French/etc)
OCR_LANG=japan
PDF_OCR_FALLBACK=true