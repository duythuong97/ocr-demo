# Default tuning parameters — committed to git.
# Override any value by setting it in .env (host-specific / secrets).

# ── Solr ──────────────────────────────────────────────────────────────────────
SOLR_TIMEOUT=10

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_COLLECTION=semantic_chunks
SEMANTIC_MIN_SCORE=0.45
SEMANTIC_MAX_TEXT_CHARS=250000
SEMANTIC_MAX_CHUNKS_PER_FILE=120
SEMANTIC_SKIP_FILE_TYPES=

# ── Neo4j (only used when GRAPH_ENABLED=true) ─────────────────────────────────
NEO4J_DATABASE=neo4j
GRAPH_RULES_PATH=graph_rules.yaml
AGENT_MAX_ITERATIONS=6

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_PORT=5100
SHUTDOWN_FORCE_EXIT_SECONDS=8
APP_PREFIX=ocr-search
SIMULATE_SUBDIRECTORY=true
# Folder on the HOST that contains all your source repos.
# Docker will mount it at /repos inside the container.
REPOS_ROOT=..

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=120
RAG_TOP_K=5
RAG_CONTEXT_CHARS_PER_DOC=4000
RAG_SYSTEM_PROMPT=You are a helpful assistant. Answer ONLY based on the context documents provided below. Do NOT use your own training knowledge or make up information that is not present in the context. Cite the source file name when referencing specific content. If the context documents do not contain the answer, respond with: I could not find relevant information in the indexed documents.

# ── Search / Retrieval ────────────────────────────────────────────────────────
DEFAULT_ROWS=10
DEFAULT_OPERATOR=OR
DEFAULT_PARSER=edismax
RETRIEVAL_RRF_K=60

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_LISTWISE_BATCH=20

# ── OCR ───────────────────────────────────────────────────────────────────────
TESSERACT_LANG=jpn+eng
PDF_OCR_FALLBACK=true