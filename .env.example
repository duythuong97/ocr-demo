# Copy this file to .env and fill in your values.
# Only host-specific settings and secrets belong here.
# All tunables with safe defaults are in .env.defaults (already committed).

# ── Infrastructure ────────────────────────────────────────────────────────────
SOLR_URL=http://localhost:8983/solr/documents
QDRANT_URL=http://localhost:6333
EMBEDDER_URL=http://localhost:11434

# ── Models ────────────────────────────────────────────────────────────────────
SEMANTIC_MODEL=BAAI/bge-m3
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your-model-name

# ── Neo4j credentials ─────────────────────────────────────────────────────────
GRAPH_ENABLED=false
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_URL=http://localhost:1234/v1
RERANKER_MODEL=your-reranker-model-name

REPOS_ROOT=/path/to/your/repos