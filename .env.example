# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit secrets.

# ── Solr ──────────────────────────────────────────────────────────────────────
SOLR_URL=http://localhost:8983/solr/documents
SOLR_TIMEOUT=10

# ── Semantic / Qdrant ─────────────────────────────────────────────────────────
SEMANTIC_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=semantic_chunks
# Path to Qdrant local storage directory (absolute or relative to project root)
QDRANT_STORAGE_PATH=data/qdrant/storage
SEMANTIC_MIN_SCORE=0.45
SEMANTIC_MAX_TEXT_CHARS=250000
SEMANTIC_MAX_CHUNKS_PER_FILE=120
SEMANTIC_SKIP_FILE_TYPES=

# ── App ───────────────────────────────────────────────────────────────────────
FLASK_PORT=5100
SHUTDOWN_FORCE_EXIT_SECONDS=8
APP_PREFIX=ocr-search
# Set to false in production / behind a reverse proxy
SIMULATE_SUBDIRECTORY=true

# ── RAG chat defaults ─────────────────────────────────────────────────────────
RAG_TOP_K=5
# hybrid | semantic | fulltext
RAG_SEARCH_MODE=hybrid
# Override the system prompt sent to the model
# RAG_SYSTEM_PROMPT=You are a helpful assistant...

# ── Search defaults ───────────────────────────────────────────────────────────
DEFAULT_ROWS=10
DEFAULT_OPERATOR=OR
DEFAULT_PARSER=edismax
