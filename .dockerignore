# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Development / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore

# Secrets — never bake into image
.env
*.env

# Logs
logs/
*.log

# Test / CI
.tox/
.nox/
htmlcov/
.coverage
coverage.xml
*.junit.xml

# Build artifacts
dist/
build/

# Data volumes — mounted at runtime, not baked in
data/qdrant/

# Docker files themselves (no need to copy into the image)
docker/
# Re-include the Solr configset — needed by Dockerfile.solr COPY instruction
!docker/solr/
!docker/solr/configset/
!docker/solr/configset/conf/
!docker/solr/configset/conf/**
# Re-include entrypoint script
!docker/entrypoint.sh
