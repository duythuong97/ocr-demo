{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow.schema.json",
  "title": "業務フロー定義",
  "type": "object",
  "required": ["id", "title", "system", "summary", "steps"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "全フローで一意な ID" },
    "title": { "type": "string" },
    "system": { "type": "string", "description": "対象システム名" },
    "category": { "type": "string", "description": "一覧のグループ名（例: 営業 / 受注）" },
    "summary": { "type": "string" },
    "roles": { "type": "array", "items": { "type": "string" } },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "owner": { "type": "string" },
    "updated": { "type": ["string"], "description": "YYYY-MM-DD" },
    "version": { "type": "integer" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string" }, "location": { "type": "string" } }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "type": { "enum": ["action", "decision"], "default": "action" },
        "title": { "type": "string" },
        "actor": { "type": "string", "description": "操作する人・ロール。自動処理は「システム」" },
        "screen": { "type": "string", "description": "画面ID と画面名" },
        "description": { "type": "string" },
        "actions": { "type": "array", "items": { "type": "string" } },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "properties": {
              "field": { "type": "string" },
              "example": { "type": "string" },
              "required": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        },
        "expected": { "type": "string" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "fix": { "type": "string" } }
          }
        },
        "tips": { "type": "array", "items": { "type": "string" } },
        "next": { "type": "string", "description": "次のステップID。省略時は配列の次" },
        "end": { "type": "boolean", "description": "true ならこのステップでフロー完了" },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "next"],
            "properties": { "label": { "type": "string" }, "next": { "type": "string" }, "note": { "type": "string" } }
          }
        }
      }
    }
  }
}
